# Postgres on Neon. Leave empty in local dev to use an embedded PGlite database in .data/
DATABASE_URL=
# LLM wording (reasons and headline). Leave all keys empty for template wording only (llm_status = skipped).
# Gemini Flash is the intended provider; Anthropic works behind the same interface.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# gemini | anthropic. Default: whichever key is set (Gemini first).
LLM_PROVIDER=
# Defaults: gemini-3.8-flash for Gemini, claude-haiku-4-5-20251001 for Anthropic. Verify the model id with the provider.
LLM_MODEL=
# Optional USD per million tokens, used only to log run cost. Check current pricing for LLM_MODEL.
LLM_PRICE_IN_PER_MTOK=1
LLM_PRICE_OUT_PER_MTOK=5
# Vercel sends this as "Authorization: Bearer <CRON_SECRET>" on cron calls.
CRON_SECRET=change-me-long-random-string
# 1 = OPEN ACCESS: anyone with the link acts as a guest administrator, no sign-in (approve, run, export, kill switch,
# settings). For demonstrations and marking only; never with real data. Actions are logged as "Guest".
OPEN_ACCESS=1
# 1 = anyone with the link can only VIEW (read-only); changes still need a sign-in. Ignored when OPEN_ACCESS=1.
PUBLIC_VIEW=0
# Keys the signed session cookie (16+ characters). Rotate to sign everyone out.
SESSION_SECRET=change-me-to-a-long-random-string
# Named users, created by `npm run seed:users`. Roles: planner, sponsor, data, admin. There are no passwords:
# people sign in with a one-time link sent to their email (needs RESEND_API_KEY below).
SEED_USERS=[{"email":"raghav@freshroots.example","name":"Raghav","role":"planner"}]
# Public address of the app, used in sign-in links (e.g. https://planner.freshroots.example).
APP_URL=
# Local development only: show the sign-in link on screen instead of emailing it. Ignored on Vercel production.
AUTH_DEV_LINKS=
# Alert emails (kill switch tripped, run failed or degraded). Optional; without them alerts are logged only.
RESEND_API_KEY=
ALERT_EMAIL=deepa@freshroots.example,it@freshroots.example
ALERT_FROM=
# Zoho Inventory connector (optional, see docs/ZOHO.md). All four are needed to switch it on.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORG_ID=
# in (India, default) | com | eu | com.au | jp | ca | sa | com.cn
ZOHO_DC=in
ZOHO_OPEN_PO_STATUSES=issued,partially_received,open
ZOHO_DAILY_CALL_BUDGET=1000
ZOHO_WEBHOOK_SECRET=
TZ=Asia/Kolkata
