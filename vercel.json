{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/run",
      "schedule": "30 1 * * 1,4"
    },
    {
      "path": "/api/cron/kill-check",
      "schedule": "0 2 1 * *"
    },
    {
      "path": "/api/cron/resume",
      "schedule": "45 2 * * *"
    },
    {
      "path": "/api/cron/zoho-sync",
      "schedule": "15 2 * * *"
    }
  ]
}
